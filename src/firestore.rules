rules_version = '2';

// ============================================================================
// VK Outreach — Firestore security rules
// Everything is denied unless a rule below allows it.
//  • Pending / rejected / unknown accounts can read and write NOTHING.
//  • Nobody can give themselves a role or permissions — profiles can only be
//    created in three exact shapes (pending, from a verified invite, or the
//    one-time bootstrap Master), and only the Master can change them later.
//  • Writes to each collection need a non-view permission in a module that
//    actually edits that collection. Master bypasses all checks.
// Module write helpers (w_*) are generated from src/permissions.js.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity helpers ----------
    function signedIn()   { return request.auth != null; }
    function userPath(uid){ return /databases/$(database)/documents/users/$(uid); }
    function me()         { return get(userPath(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(userPath(request.auth.uid)); }
    function isActive()   { return hasProfile() && me().get('status', '') == 'active' && me().get('approved', false) == true; }
    function isMaster()   { return isActive() && me().get('role', '') == 'Master'; }
    function perms()      { let p = me().get('permissions', null); return p is map ? p : {}; }
    function can(k)       { return isMaster() || (isActive() && perms().get(k, false) == true); }
    function verified()   { return signedIn() && request.auth.token.email_verified == true; }
    // Must match inviteKey() in auth.jsx
    function emailKey()   { return request.auth.token.email.lower().replace('[^a-z0-9]', '_'); }

    // ---------- module write helpers (generated) ----------
    function w_outreach() {
      let p = perms();
      return isMaster() || (isActive() && (
        p.get('outreach.add', false) == true ||
        p.get('outreach.edit', false) == true ||
        p.get('outreach.status', false) == true ||
        p.get('outreach.delete', false) == true ||
        p.get('outreach.import', false) == true));
    }
    function w_logistics() {
      let p = perms();
      return isMaster() || (isActive() && (
        p.get('logistics.edit', false) == true ||
        p.get('logistics.flight', false) == true ||
        p.get('logistics.car', false) == true ||
        p.get('logistics.accom', false) == true ||
        p.get('logistics.poc', false) == true));
    }
    function w_schedule() {
      let p = perms();
      return isMaster() || (isActive() && (
        p.get('schedule.edit', false) == true ||
        p.get('schedule.minutemin', false) == true ||
        p.get('schedule.sahebji', false) == true));
    }
    function w_reports() {
      let p = perms();
      return isMaster() || (isActive() && (
        p.get('reports.edit', false) == true ||
        p.get('reports.poc', false) == true ||
        p.get('reports.mandatory', false) == true));
    }
    function w_poc() {
      let p = perms();
      return isMaster() || (isActive() && (
        p.get('poc.assign', false) == true ||
        p.get('poc.freeze', false) == true));
    }
    function w_people() {
      let p = perms();
      return isMaster() || (isActive() && (
        p.get('people.add', false) == true ||
        p.get('people.edit', false) == true ||
        p.get('people.delete', false) == true));
    }
    function w_availability() {
      let p = perms();
      return isMaster() || (isActive() && (
        p.get('availability.edit', false) == true));
    }
    function w_depts() {
      let p = perms();
      return isMaster() || (isActive() && (
        p.get('depts.add', false) == true ||
        p.get('depts.complete', false) == true ||
        p.get('depts.signoff', false) == true ||
        p.get('depts.delete', false) == true));
    }
    function w_checklist() {
      let p = perms();
      return isMaster() || (isActive() && (
        p.get('checklist.edit', false) == true));
    }
    function w_settings() {
      let p = perms();
      return isMaster() || (isActive() && (
        p.get('settings.users', false) == true ||
        p.get('settings.config', false) == true));
    }

    // ---------- profile creation shapes ----------
    function allowedProfileKeys() {
      return request.resource.data.keys().hasOnly([
        'email','role','approved','status','allowedModules','permissions','contactFilter',
        'deviceId','deviceLabel','createdAt','activeEventId']);
    }
    function baseProfileOK(uid) {
      return signedIn() && request.auth.uid == uid && verified()
        && allowedProfileKeys()
        && request.resource.data.email == request.auth.token.email;
    }
    function pendingShape() {
      let d = request.resource.data;
      return d.role == 'User' && d.approved == false && d.status == 'pending'
        && d.get('permissions', null) == null
        && d.get('allowedModules', null) == null
        && d.get('contactFilter', null) == null;
    }
    function matchesInvite(d, inv) {
      return d.role == inv.get('role', 'User')
        && d.approved == inv.get('approved', false)
        && d.status == inv.get('status', 'pending')
        && d.get('permissions', null) == inv.get('permissions', null)
        && d.get('allowedModules', null) == inv.get('allowedModules', null)
        && d.get('contactFilter', null) == inv.get('contactFilter', null);
    }
    function inviteShape() {
      let invPath = /databases/$(database)/documents/invites/$(emailKey());
      return exists(invPath) && matchesInvite(request.resource.data, get(invPath).data);
    }
    function bootstrapShape(uid) {
      let boot = /databases/$(database)/documents/meta/bootstrap;
      let d = request.resource.data;
      return d.role == 'Master' && d.approved == true && d.status == 'active'
        && !exists(boot)
        && getAfter(boot).data.uid == uid;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow get:    if signedIn() && (request.auth.uid == uid || can('settings.users'));
      allow list:   if can('settings.users');
      allow create: if baseProfileOK(uid) && (pendingShape() || inviteShape() || bootstrapShape(uid));
      // Self-service: only harmless personal fields
      allow update: if isMaster()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['activeEventId','deviceId','deviceLabel','lastSeen','dashboard']));
      allow delete: if isMaster() && request.auth.uid != uid;
    }

    // ---------- invites (pre-approved emails) ----------
    match /invites/{key} {
      // The invitee can read only their own invite, and only after verifying the email
      allow get:    if isMaster() || (verified() && key == emailKey());
      allow list:   if isMaster();
      allow create, update: if isMaster();
      // The invitee deletes it in the same batch that creates their profile
      allow delete: if isMaster() || (verified() && key == emailKey() && existsAfter(userPath(request.auth.uid)));
    }

    // ---------- one-time bootstrap marker ----------
    match /meta/bootstrap {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && (isMaster() || getAfter(userPath(request.auth.uid)).data.role == 'Master');
      allow update, delete: if false;
    }

    // ---------- org-level config ----------
    match /app_state/{id} {
      allow read: if isActive();
      allow write: if can('settings.config');
    }
    match /events/{id} {
      allow read: if isActive();
      allow create, update: if can('settings.config');
      allow delete: if isMaster();
    }
    match /appConfig/{id} {
      allow read: if isActive();
      allow write: if can('settings.config');
    }

    // ---------- audit log: append-only, can't impersonate ----------
    match /activity_log/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isMaster();
    }

    // ---------- trash ----------
    match /trash/{id} {
      allow read: if isActive();
      allow create: if isActive();
      allow update, delete: if isMaster();
    }

    // ---------- operational data ----------
    match /contacts/{id} {
      allow read: if isActive();
      allow write: if w_outreach();
    }
    match /contact_notes/{id} {
      allow read: if isActive();
      allow write: if w_outreach();
    }
    match /logistics/{id} {
      allow read: if isActive();
      allow write: if w_logistics() || w_outreach() || w_reports();
    }
    match /carVendors/{id} {
      allow read: if isActive();
      allow write: if w_logistics();
    }
    match /sessions/{id} {
      allow read: if isActive();
      allow write: if w_schedule();
    }
    match /assignments/{id} {
      allow read: if isActive();
      allow write: if w_schedule() || w_outreach();
    }
    match /founder/{id} {
      allow read: if isActive();
      allow write: if w_schedule() || w_outreach();
    }
    match /sahebjiSlots/{id} {
      allow read: if isActive();
      allow write: if w_schedule();
    }
    match /minuteItems/{id} {
      allow read: if isActive();
      allow write: if w_schedule();
    }
    match /personalisedSchedule/{id} {
      allow read: if isActive();
      allow write: if w_reports() || w_poc() || w_outreach();
    }
    match /personalisedMandatory/{id} {
      allow read: if isActive();
      allow write: if w_reports() || w_schedule();
    }
    match /felicitation/{id} {
      allow read: if isActive();
      allow write: if w_reports() || w_logistics() || w_outreach();
    }
    match /poc/{id} {
      allow read: if isActive();
      allow write: if w_poc() || w_people() || w_outreach();
    }
    match /volunteers/{id} {
      allow read: if isActive();
      allow write: if w_people();
    }
    match /availability/{id} {
      allow read: if isActive();
      allow write: if w_availability() || w_people();
    }
    match /departments/{id} {
      allow read: if isActive();
      allow write: if w_depts();
    }
    match /tasks/{id} {
      allow read: if isActive();
      allow write: if w_depts() || w_people();
    }
    match /checklist/{id} {
      allow read: if isActive();
      allow write: if w_checklist() || w_logistics();
    }

    // ---------- anything not listed: Master only ----------
    match /{document=**} {
      allow read, write: if isMaster();
    }
  }
}
